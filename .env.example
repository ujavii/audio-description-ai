# Copia este archivo como .env y completa los valores
# NUNCA subas .env a Git

# ── Proveedor de IA ───────────────────────────
# Opciones: openai | anthropic | gemini | openai_compatible
AI_PROVIDER=openai

# Modelo (opcional — si no se define, se usa el default del proveedor)
# AI_MODEL=gpt-4o-mini

# ── API Keys (completar solo la del proveedor elegido) ──
OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIzaSy-...

# ── Proveedor compatible con OpenAI (DeepSeek, Groq, Mistral, Ollama, etc.) ──
# AI_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_API_KEY=...
# OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com

# ── Rutas personalizadas (opcional) ──────────
# Si se omiten, se usan las rutas relativas al proyecto por defecto
# AUDIOS_DIR=C:\ruta\a\tus\audios
# OUTPUTS_DIR=C:\ruta\a\outputs
# TRANSCRIPCIONES_DIR=C:\ruta\a\transcripciones

# ── Modelo de Whisper (faster-whisper) ───────
# Opciones: tiny | base | small | medium | large-v1 | large-v2 | large-v3
FW_MODEL_SIZE=medium

# ── FFmpeg (dejar vacío si ya está en PATH) ───
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
